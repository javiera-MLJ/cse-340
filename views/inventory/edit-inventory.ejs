<h1><%= title %></h1>

<% if (errors) { %>
    <ul class="notice">
    <% errors.array().forEach(error => { %>
        <li><%= error.msg %></li>
    <% }) %>
    </ul>
<% } %>

<div class="form-wrapper">
    <form id="updateForm" method="post" action="/inv/update">
        <input type="hidden" name="inv_id" <% if (locals.inv_id) { %> value="<%= locals.inv_id %>" <% } %>>


        <label for="classification_id">Classification</label>
        <%- classificationSelect %>

        <label for="inv_make">Make</label>
        <input type="text" name="inv_make" id="inv_make" value="<%= inv_make %>">

        <label for="inv_model">Model</label>
        <input type="text" name="inv_model" id="inv_model" value="<%= inv_model %>">

        <label for="inv_year">Year</label>
        <input type="text" name="inv_year" id="inv_year" value="<%= inv_year %>">

        <label for="inv_description">Description</label>
        <textarea name="inv_description" id="inv_description"><%= inv_description %></textarea>

        <label for="inv_image">Image Path</label>
        <input type="text" name="inv_image" id="inv_image" value="<%= inv_image %>">

        <label for="inv_thumbnail">Thumbnail Path</label>
        <input type="text" name="inv_thumbnail" id="inv_thumbnail" value="<%= inv_thumbnail %>">

        <label for="inv_price">Price</label>
        <input type="text" name="inv_price" id="inv_price" value="<%= inv_price %>">

        <label for="inv_miles">Miles</label>
        <input type="text" name="inv_miles" id="inv_miles" value="<%= inv_miles %>">

        <label for="inv_color">Color</label>
        <input type="text" name="inv_color" id="inv_color" value="<%= inv_color %>">




        <button type="submit" disabled>Update Vehicle</button>
    </form>
</div>

<script src="/js/inv-update.js"></script>

